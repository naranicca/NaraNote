<Window x:Class="NaraNote.App.Views.ReminderWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NaraNote" Width="400" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 UseLayoutRounding="True" SnapsToDevicePixels="True" Icon="/NaraNote;component/Resources/NaraNote.ico" Background="#FFF8E5">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#FFF4F4F4"/><Setter Property="BorderBrush" Value="#FFB8B8B8"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="10,4"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="MinWidth" Value="76"/><Setter Property="Height" Value="30"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FFE8F2FC"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF78AEDD"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FFD9EAF8"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Height" Value="30"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#FFB8B8B8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7,4"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="TextBoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#FF78AEDD"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#FF297CC1"/><Setter TargetName="TextBoxBorder" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Height" Value="30"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#FFB8B8B8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="7,4"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
    <ContentPresenter x:Name="SelectionPresenter" Margin="8,3,30,3" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"/>
    <TextBox x:Name="PART_EditableTextBox" Margin="3,2,29,2" Padding="5,1" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <ToggleButton Width="28" HorizontalAlignment="Right" Focusable="False" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" CornerRadius="0,4,4,0"><Path Width="8" Height="5" Fill="#FF555555" Stretch="Fill" Data="M 0 0 L 8 0 L 4 5 Z"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
    <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"><Border Margin="0,3,0,0" Padding="2" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="White" BorderBrush="#FFB8B8B8" BorderThickness="1" CornerRadius="4"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEditable" Value="True"><Setter TargetName="SelectionPresenter" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#FF78AEDD"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#FF297CC1"/><Setter TargetName="ComboBorder" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="CheckBoxSurface" Width="18" Height="18" Background="White" BorderBrush="#FF8E8E93" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center" SnapsToDevicePixels="True"><TextBlock x:Name="CheckMark" Text="✓" Margin="0,-1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Symbol" FontSize="13" FontWeight="SemiBold" Foreground="White" Visibility="Collapsed"/></Border>
    <ContentPresenter Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center"/>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBoxSurface" Property="BorderBrush" Value="DodgerBlue"/><Setter TargetName="CheckBoxSurface" Property="Background" Value="#FFF4F9FF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckBoxSurface" Property="BorderBrush" Value="DodgerBlue"/><Setter TargetName="CheckBoxSurface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBoxSurface" Property="Background" Value="DodgerBlue"/><Setter TargetName="CheckBoxSurface" Property="BorderBrush" Value="DodgerBlue"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <StackPanel Margin="20">
  <TextBlock Text="리마인더" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <Calendar x:Name="ReminderCalendar" HorizontalAlignment="Center" DisplayMode="Month" SelectionMode="SingleDate" FontSize="13">
   <Calendar.LayoutTransform><ScaleTransform ScaleX="1.4" ScaleY="1.4"/></Calendar.LayoutTransform>
  </Calendar>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
   <CheckBox x:Name="Use24HourCheck" Content="24시간제" Height="30" Margin="0,0,12,0" Checked="TimeFormatCheck_Changed" Unchecked="TimeFormatCheck_Changed"/>
   <ComboBox x:Name="AmPmBox" Width="76" Margin="0,0,8,0"><ComboBoxItem Content="오전"/><ComboBoxItem Content="오후"/></ComboBox>
   <ComboBox x:Name="HourBox" Width="68" Height="32" IsEditable="True" IsTextSearchEnabled="False" MaxDropDownHeight="240" ToolTip="시" DropDownOpened="TimePart_DropDownOpened"/>
   <TextBlock Text=":" FontSize="18" Margin="7,0" VerticalAlignment="Center"/>
   <ComboBox x:Name="MinuteBox" Width="68" Height="32" IsEditable="True" IsTextSearchEnabled="False" MaxDropDownHeight="240" ToolTip="분 (0~59)" DropDownOpened="TimePart_DropDownOpened"/>
  </StackPanel>
  <Grid Margin="0,14,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Text="반복" VerticalAlignment="Center"/>
   <ComboBox x:Name="RecurrenceBox" Grid.Column="1" SelectionChanged="RecurrenceBox_SelectionChanged">
    <ComboBoxItem Content="한 번"/><ComboBoxItem Content="매일 같은 시간"/><ComboBoxItem Content="매주 같은 시간"/><ComboBoxItem Content="지정한 요일 같은 시간"/>
   </ComboBox>
  </Grid>
  <StackPanel x:Name="WeekdayPanel" Margin="0,12,0,0" Visibility="Collapsed">
   <TextBlock Text="요일" Margin="0,0,0,6"/>
   <UniformGrid Columns="7"><CheckBox x:Name="Sunday" Content="일"/><CheckBox x:Name="Monday" Content="월"/><CheckBox x:Name="Tuesday" Content="화"/><CheckBox x:Name="Wednesday" Content="수"/><CheckBox x:Name="Thursday" Content="목"/><CheckBox x:Name="Friday" Content="금"/><CheckBox x:Name="Saturday" Content="토"/></UniformGrid>
  </StackPanel>
  <DockPanel Margin="0,20,0,0" LastChildFill="False">
   <Button x:Name="DisableButton" Content="리마인더 해제" DockPanel.Dock="Left" MinWidth="100" Click="Disable_Click"/>
   <Button Content="취소" DockPanel.Dock="Right" Margin="8,0,0,0" IsCancel="True"/>
   <Button Content="확인" DockPanel.Dock="Right" Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
  </DockPanel>
 </StackPanel>
</Window>

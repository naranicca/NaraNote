<Window x:Class="NaraNote.App.Views.NoteWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Width="360" Height="320"
 MinWidth="220" MinHeight="160" ShowInTaskbar="True" AllowDrop="True" Icon="/NaraNote;component/Resources/NaraNote.ico">
 <Window.Resources>
  <Style x:Key="HeaderButtonStyle" TargetType="Button">
   <Setter Property="Width" Value="28"/>
   <Setter Property="Height" Value="28"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#18000000"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#30000000"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="HeaderIconLineStyle" TargetType="Line">
   <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
   <Setter Property="StrokeThickness" Value="2"/>
   <Setter Property="StrokeStartLineCap" Value="Round"/>
   <Setter Property="StrokeEndLineCap" Value="Round"/>
  </Style>
 </Window.Resources>
 <Border x:Name="Frame" Margin="13" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6">
  <Border.Effect>
   <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="2" Direction="270" Opacity="0.28" RenderingBias="Quality"/>
  </Border.Effect>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="TitleArea" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleArea_MouseLeftButtonDown">
    <Button x:Name="NewNoteButton" Style="{StaticResource HeaderButtonStyle}" HorizontalAlignment="Left" ToolTip="새 노트 (Ctrl+N)" Click="New_Click">
     <Viewbox Width="16" Height="16"><Canvas Width="18" Height="18">
      <Line X1="9" Y1="3.5" X2="9" Y2="14.5" Style="{StaticResource HeaderIconLineStyle}"/>
      <Line X1="3.5" Y1="9" X2="14.5" Y2="9" Style="{StaticResource HeaderIconLineStyle}"/>
     </Canvas></Viewbox>
    </Button>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="SettingsButton" Style="{StaticResource HeaderButtonStyle}" ToolTip="설정" Click="Settings_Click">
      <Viewbox Width="16" Height="16" Stretch="Uniform">
       <Canvas Width="18" Height="18">
        <Line X1="3" Y1="4" X2="6" Y2="4" Style="{StaticResource HeaderIconLineStyle}"/>
        <Ellipse Canvas.Left="6" Canvas.Top="2" Width="4" Height="4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"/>
        <Line X1="10" Y1="4" X2="15" Y2="4" Style="{StaticResource HeaderIconLineStyle}"/>
        <Line X1="3" Y1="9" X2="10" Y2="9" Style="{StaticResource HeaderIconLineStyle}"/>
        <Ellipse Canvas.Left="10" Canvas.Top="7" Width="4" Height="4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"/>
        <Line X1="14" Y1="9" X2="15" Y2="9" Style="{StaticResource HeaderIconLineStyle}"/>
        <Line X1="3" Y1="14" X2="7" Y2="14" Style="{StaticResource HeaderIconLineStyle}"/>
        <Ellipse Canvas.Left="7" Canvas.Top="12" Width="4" Height="4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"/>
        <Line X1="11" Y1="14" X2="15" Y2="14" Style="{StaticResource HeaderIconLineStyle}"/>
       </Canvas>
      </Viewbox>
     </Button>
     <Button x:Name="CloseNoteButton" Style="{StaticResource HeaderButtonStyle}" ToolTip="이 노트 닫기" Click="Close_Click">
      <Viewbox Width="16" Height="16"><Canvas Width="18" Height="18">
       <Line X1="4" Y1="4" X2="14" Y2="14" Style="{StaticResource HeaderIconLineStyle}"/>
       <Line X1="14" Y1="4" X2="4" Y2="14" Style="{StaticResource HeaderIconLineStyle}"/>
      </Canvas></Viewbox>
     </Button>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" x:Name="Surface" AllowDrop="True" ClipToBounds="True">
    <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" AllowDrop="True"
      BorderThickness="0" Background="Transparent" Padding="10" VerticalScrollBarVisibility="Auto"
      TextChanged="Editor_TextChanged" PreviewKeyDown="Editor_PreviewKeyDown"/>
    <Canvas x:Name="ObjectCanvas" Background="{x:Null}" ClipToBounds="True"/>
    <InkCanvas x:Name="Ink" Background="Transparent" EditingMode="None" IsHitTestVisible="False" StrokeCollected="Ink_StrokeCollected"/>
   </Grid>
  </Grid>
 </Border>
</Window>

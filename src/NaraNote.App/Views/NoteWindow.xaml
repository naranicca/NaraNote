<Window x:Class="NaraNote.App.Views.NoteWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:controls="clr-namespace:NaraNote.App.Controls"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:loc="clr-namespace:NaraNote.App.Localization"
 Title="NaraNote" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False" Background="#FFF3A6" Width="360" Height="320"
 MinWidth="220" MinHeight="160" ShowInTaskbar="True" AllowDrop="True" Icon="/NaraNote;component/Resources/NaraNote.ico">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="HeaderButtonStyle" TargetType="Button">
   <Setter Property="Width" Value="28"/>
   <Setter Property="Height" Value="28"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#18000000"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#30000000"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="HeaderIconLineStyle" TargetType="Line">
   <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
   <Setter Property="StrokeThickness" Value="2"/>
   <Setter Property="StrokeStartLineCap" Value="Round"/>
   <Setter Property="StrokeEndLineCap" Value="Round"/>
  </Style>
  <Style x:Key="SearchButtonStyle" TargetType="Button">
   <Setter Property="Width" Value="24"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="FontSize" Value="16"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="SearchButtonBorder" Background="{TemplateBinding Background}" CornerRadius="14"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SearchButtonBorder" Property="Background" Value="#18000000"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="SearchButtonBorder" Property="Background" Value="#30000000"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SearchOptionStyle" TargetType="CheckBox">
   <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Foreground" Value="#FF3C3C43"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="OptionBorder" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OptionBorder" Property="Background" Value="#18000000"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="OptionBorder" Property="Background" Value="#FF2F7DE1"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Keep the scrollbar inside the 6-DIP window resize grip so scrolling and resizing never compete. -->
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="11"/>
   <Setter Property="MinWidth" Value="11"/>
   <Setter Property="Margin" Value="0,5,6,5"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Opacity" Value="0.34"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ScrollBar">
      <Grid Background="Transparent">
       <Track x:Name="PART_Track" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
         <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Background="Transparent">
          <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
         </RepeatButton>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
         <controls:CapsuleThumb Width="6" MinimumVisualLength="0" Background="#9A3C3C43"
                                HoverBackground="#C83C3C43" DragBackground="#E63C3C43"
                                Template="{x:Null}" FocusVisualStyle="{x:Null}"
                                ClipToBounds="False" SnapsToDevicePixels="False"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
         <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Background="Transparent">
          <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
         </RepeatButton>
        </Track.IncreaseRepeatButton>
       </Track>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="Frame" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="TitleArea" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleArea_MouseLeftButtonDown">
    <Grid Margin="80,0,62,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="ExportPathTextBlock" Grid.Column="0" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Opacity="0.72"/>
     <TextBlock x:Name="ExportDirtyIndicator" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" Text="●" FontSize="8" FontWeight="SemiBold" Opacity="0.82" Visibility="Collapsed" ToolTip="{loc:Loc DirtyExport}"/>
    </Grid>
    <Button x:Name="NewNoteButton" Style="{StaticResource HeaderButtonStyle}" HorizontalAlignment="Left" Margin="6,0,0,0" ToolTip="{loc:Loc NewNote}" Click="New_Click">
     <Viewbox Width="16" Height="16"><Canvas Width="18" Height="18">
      <Line X1="9" Y1="3.5" X2="9" Y2="14.5" Style="{StaticResource HeaderIconLineStyle}"/>
      <Line X1="3.5" Y1="9" X2="14.5" Y2="9" Style="{StaticResource HeaderIconLineStyle}"/>
     </Canvas></Viewbox>
    </Button>
    <Button x:Name="PinButton" Style="{StaticResource HeaderButtonStyle}" HorizontalAlignment="Left" Margin="24,0,0,0" ToolTip="{loc:Loc AlwaysOnTop}" Click="Pin_Click">
     <Viewbox x:Name="PinIconViewbox" Width="16" Height="16" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
      <Canvas Width="18" Height="18">
       <Path x:Name="PinHeadPath" Data="M6,3 L12,3 L11,7 L13,10 L5,10 L7,7 Z"
         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"
         StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
       <Line X1="9" Y1="10" X2="9" Y2="15" Style="{StaticResource HeaderIconLineStyle}"/>
      </Canvas>
     </Viewbox>
    </Button>
    <Button x:Name="ReminderButton" Style="{StaticResource HeaderButtonStyle}" HorizontalAlignment="Left" Margin="48,0,0,0" Visibility="Collapsed" ToolTip="{loc:Loc Reminder}" ToolTipOpening="ReminderButton_ToolTipOpening" Click="Reminder_Click">
     <Viewbox Width="14" Height="14" Stretch="Uniform"><Canvas Width="18" Height="18">
      <Path Data="M 9,2.2 C 6.2,2.2 4.5,4.5 4.5,7.3 L 4.5,10.1 C 4.5,11.2 4,12.2 3.1,13 L 2.5,13.6 L 15.5,13.6 L 14.9,13 C 14,12.2 13.5,11.2 13.5,10.1 L 13.5,7.3 C 13.5,4.5 11.8,2.2 9,2.2 Z"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
      <Path Data="M 7.1,15 C 7.5,16.1 8.2,16.5 9,16.5 C 9.8,16.5 10.5,16.1 10.9,15"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
     </Canvas></Viewbox>
    </Button>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="SettingsButton" Style="{StaticResource HeaderButtonStyle}" ToolTip="{loc:Loc Menu}" Click="Menu_Click">
      <Viewbox Width="16" Height="16" Stretch="Uniform">
       <Canvas Width="18" Height="18">
        <Line X1="4" Y1="5" X2="14" Y2="5" Style="{StaticResource HeaderIconLineStyle}"/>
        <Line X1="4" Y1="9" X2="14" Y2="9" Style="{StaticResource HeaderIconLineStyle}"/>
        <Line X1="4" Y1="13" X2="14" Y2="13" Style="{StaticResource HeaderIconLineStyle}"/>
       </Canvas>
      </Viewbox>
     </Button>
     <Button x:Name="CloseNoteButton" Style="{StaticResource HeaderButtonStyle}" ToolTip="{loc:Loc CloseNote}" Click="Close_Click">
      <Viewbox Width="16" Height="16"><Canvas Width="18" Height="18">
       <Line X1="4" Y1="4" X2="14" Y2="14" Style="{StaticResource HeaderIconLineStyle}"/>
       <Line X1="14" Y1="4" X2="4" Y2="14" Style="{StaticResource HeaderIconLineStyle}"/>
      </Canvas></Viewbox>
     </Button>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" x:Name="Surface" AllowDrop="True" ClipToBounds="True">
    <avalonEdit:TextEditor x:Name="Editor" WordWrap="True" AllowDrop="True" ShowLineNumbers="False"
      Background="Transparent" Padding="10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
      TextChanged="Editor_TextChanged" PreviewKeyDown="Editor_PreviewKeyDown"/>
    <Canvas x:Name="ImeCompositionCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
    <Canvas x:Name="ObjectCanvas" Background="{x:Null}" ClipToBounds="True"/>
    <InkCanvas x:Name="Ink" Background="Transparent" EditingMode="None" IsHitTestVisible="False" StrokeCollected="Ink_StrokeCollected"/>
    <Border x:Name="SearchBar" Width="300" Height="38" Margin="8,8,8,0" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed"
            Background="#F8FFFFFF" BorderBrush="#38000000" BorderThickness="1" CornerRadius="12" Panel.ZIndex="100">
     <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18"/></Border.Effect>
     <Grid Margin="5,0,4,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchTextBox" Grid.Column="0" Margin="4,0,0,0" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13"
               ToolTip="Search" TextChanged="SearchTextBox_TextChanged" PreviewKeyDown="SearchTextBox_PreviewKeyDown"/>
      <CheckBox x:Name="SearchCaseCheckBox" Grid.Column="1" Style="{StaticResource SearchOptionStyle}" Content="Aa" ToolTip="Match case" Checked="SearchOptionChanged" Unchecked="SearchOptionChanged"/>
      <CheckBox x:Name="SearchWordCheckBox" Grid.Column="2" Style="{StaticResource SearchOptionStyle}" Content="W" ToolTip="Match whole word" Checked="SearchOptionChanged" Unchecked="SearchOptionChanged"/>
      <Button Grid.Column="3" Style="{StaticResource SearchButtonStyle}" Content="‹" ToolTip="Previous match" Click="SearchPrevious_Click"/>
      <Button Grid.Column="4" Style="{StaticResource SearchButtonStyle}" Content="›" ToolTip="Next match" Click="SearchNext_Click"/>
      <Button Grid.Column="5" Style="{StaticResource SearchButtonStyle}" Content="×" ToolTip="Close search" Click="SearchClose_Click"/>
     </Grid>
    </Border>
   </Grid>
  </Grid>
 </Border>
</Window>

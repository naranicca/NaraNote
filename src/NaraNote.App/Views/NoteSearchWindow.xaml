<Window x:Class="NaraNote.App.Views.NoteSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NaraNote.App.Localization"
        Title="NaraNote" AutomationProperties.Name="{loc:Loc SearchNotes}" Icon="/NaraNote;component/Resources/NaraNote.ico"
        Style="{StaticResource DialogWindowStyle}" Width="520" Height="390" MinWidth="300" MinHeight="210"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="Window_PreviewKeyDown">
 <Grid Margin="22,18,22,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="{loc:Loc SearchNotes}" Style="{StaticResource DialogTitleStyle}" Margin="2,0,0,14" TextWrapping="Wrap"/>
  <Border Grid.Row="1" Style="{StaticResource DialogCardStyle}">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
     <TextBox x:Name="Query" Style="{StaticResource DialogTextBoxStyle}" Padding="16,2,6,2" FontSize="14"
              AutomationProperties.Name="{loc:Loc SearchNotes}" TextChanged="Query_Changed"/>
     <TextBlock IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0"
                FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FF6E6E73" Text="&#xE721;"/>
    </Grid>
    <TextBlock x:Name="Status" Text="{loc:Loc SearchNotesPrompt}" TextWrapping="Wrap" IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite">
     <TextBlock.Style>
      <Style TargetType="TextBlock" BasedOn="{StaticResource DialogSectionLabelStyle}">
       <Setter Property="Grid.Row" Value="1"/><Setter Property="Margin" Value="2,13,2,6"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding HasItems, ElementName=Results}" Value="False">
         <Setter Property="Grid.Row" Value="2"/><Setter Property="Margin" Value="6"/>
         <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
         <Setter Property="TextAlignment" Value="Center"/><Setter Property="FontWeight" Value="Normal"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
    <ListBox x:Name="Results" Grid.Row="2" BorderThickness="0" Background="Transparent" Padding="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling"
             PreviewMouseLeftButtonUp="Results_MouseLeftButtonUp">
     <ListBox.Style>
      <Style TargetType="ListBox">
       <Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
      </Style>
     </ListBox.Style>
     <ListBox.ItemContainerStyle>
      <Style TargetType="ListBoxItem">
       <Setter Property="Margin" Value="0,0,0,3"/><Setter Property="Padding" Value="10,7"/>
       <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ListBoxItem">
         <Border x:Name="Row" CornerRadius="7" Padding="{TemplateBinding Padding}"
                 Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
          <ContentPresenter/>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#FFF5F5F7"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#FFEAF4FF"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#FF0A84FF"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
       </Setter>
      </Style>
     </ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate>
      <DataTemplate>
       <StackPanel>
        <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Text" Value="{Binding Title}"/>
           <Style.Triggers><DataTrigger Binding="{Binding Title}" Value=""><Setter Property="Text" Value="{loc:Loc UntitledNote}"/></DataTrigger></Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Foreground="#FF48484A" Margin="0,3,0,0"><Run Text="{Binding Before, Mode=OneWay}"/><Run Text="{Binding Match, Mode=OneWay}" FontWeight="SemiBold" Background="#FFCFE6FF" Foreground="#FF003F80"/><Run Text="{Binding After, Mode=OneWay}"/></TextBlock>
       </StackPanel>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
   </Grid>
  </Border>
 </Grid>
</Window>

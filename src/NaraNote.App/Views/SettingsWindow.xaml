<Window x:Class="NaraNote.App.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="설정" Width="370" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Icon="/NaraNote;component/Resources/NaraNote.ico">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#FFF4F4F4"/>
   <Setter Property="BorderBrush" Value="#FFB8B8B8"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="10,4"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FFE8F2FC"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF78AEDD"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FFD9EAF8"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#FFB8B8B8"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="7,4"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TextBox">
      <Border x:Name="TextBoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
       <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#FF78AEDD"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#FF297CC1"/><Setter TargetName="TextBoxBorder" Property="BorderThickness" Value="2"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#FFB8B8B8"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="7,4"/>
   <Setter Property="MinHeight" Value="29"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
       <ContentPresenter x:Name="SelectionPresenter" Margin="8,3,30,3" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" IsHitTestVisible="False"/>
       <TextBox x:Name="PART_EditableTextBox" Margin="3,2,29,2" Padding="5,1" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
       <ToggleButton x:Name="DropDownToggle" Width="28" HorizontalAlignment="Right" Focusable="False" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent" CornerRadius="0,4,4,0">
           <Path Width="8" Height="5" Fill="#FF555555" Stretch="Fill" Data="M 0 0 L 8 0 L 4 5 Z"/>
          </Border>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
        <Border Margin="0,3,0,0" Padding="2" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="White" BorderBrush="#FFB8B8B8" BorderThickness="1" CornerRadius="4">
         <ScrollViewer><ItemsPresenter/></ScrollViewer>
        </Border>
       </Popup>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsEditable" Value="True"><Setter TargetName="SelectionPresenter" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#FF78AEDD"/></Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#FF297CC1"/><Setter TargetName="ComboBorder" Property="BorderThickness" Value="2"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border x:Name="CheckBorder" Width="17" Height="17" Background="White" BorderBrush="#FF9E9E9E" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center"/>
       <Path x:Name="CheckMark" Grid.Column="0" Width="10" Height="8" Data="M 0 4 L 3.5 7.5 L 10 0" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
       <ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="#FF297CC1"/></Trigger>
       <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="#FF297CC1"/><Setter TargetName="CheckBorder" Property="BorderBrush" Value="#FF297CC1"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
   </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Height" Value="32"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Slider">
      <Grid>
       <Border Height="5" Margin="7,0" VerticalAlignment="Center" Background="#FFD7D7D7" CornerRadius="2"/>
       <Track x:Name="PART_Track" Margin="7,0" VerticalAlignment="Center">
        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0" Focusable="False"/></Track.DecreaseRepeatButton>
        <Track.Thumb>
         <Thumb Width="16" Height="20">
          <Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBorder" Background="#FF297CC1" BorderBrush="White" BorderThickness="2" CornerRadius="5"><Border.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25"/></Border.Effect></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="#FF1F68A5"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="#FF174F7E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template>
         </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" Focusable="False"/></Track.IncreaseRepeatButton>
       </Track>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ColorPresetButtonStyle" TargetType="Button">
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid>
       <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
       <Border x:Name="HoverOverlay" Background="Transparent" CornerRadius="4"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="HoverOverlay" Property="Background" Value="#140078D4"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="HoverOverlay" Property="Background" Value="#260078D4"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="현재 노트" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
   <TextBlock Text="글꼴"/>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="FontBox" Grid.Column="0" Margin="0,0,8,0" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="240" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
    <ComboBox x:Name="SizeBox" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="220" ToolTip="글꼴 크기"/>
   </Grid>
   <TextBlock Text="색상" Margin="0,10,0,4"/><WrapPanel x:Name="Colors"/>
   <TextBlock Text="펜 색상" Margin="0,12,0,4"/><WrapPanel x:Name="PenColors"/>
   <Grid Margin="0,8,0,0">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="150"/>
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Text="펜 굵기" VerticalAlignment="Center"/>
    <Grid Grid.Column="1">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
     <Slider x:Name="PenThicknessSlider" Grid.Column="0" Minimum="1" Maximum="10" Ticks="1,2,3.5,6,10" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1" ToolTip="펜 굵기" ValueChanged="PenThicknessSlider_ValueChanged"/>
     <TextBox x:Name="PenThicknessTextBox" Grid.Column="1" Margin="4,2,0,2" Padding="3,1" HorizontalContentAlignment="Center" ToolTip="펜 굵기 숫자 입력 (1~10)" LostKeyboardFocus="PenThicknessTextBox_LostKeyboardFocus" PreviewKeyDown="PenThicknessTextBox_PreviewKeyDown"/>
    </Grid>
   </Grid>
   <Separator Margin="0,16"/><TextBlock Text="전체 설정" FontWeight="Bold" FontSize="16"/>
   <CheckBox x:Name="TrayBox" Content="시스템 트레이 사용" Margin="0,10,0,0"/>
   <CheckBox x:Name="StartupBox" Content="Windows 시작 시 실행" Margin="0,8,0,0"/>
   <Grid Margin="0,10,0,0">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="150"/>
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Text="새 노트 전역 단축키" VerticalAlignment="Center"/>
    <TextBox x:Name="NewNoteHotKey" Grid.Column="1" VerticalContentAlignment="Center"/>
   </Grid>
   <Grid Margin="0,8,0,0">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="150"/>
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Text="노트 표시/숨김 전역 단축키" VerticalAlignment="Center"/>
    <TextBox x:Name="ToggleHotKey" Grid.Column="1" VerticalContentAlignment="Center"/>
   </Grid>
  </StackPanel>
  <Button Grid.Row="1" Content="확인" Width="90" Height="32" Margin="0,16,0,0" HorizontalAlignment="Right" Click="Ok_Click"/>
 </Grid>
</Window>
